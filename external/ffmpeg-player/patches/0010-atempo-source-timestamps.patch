@@ -1068,6 +1073,19 @@
                      (AVRational){ 1, outlink->sample_rate },
                      outlink->time_base);
 
+    if (atempo->source_timestamps) {
+        /* A tempo command moves the origin inside an overlap window. The
+         * caller cannot reconstruct this from output samples * latest tempo.
+         * Keep normal output PTS and attach the source coordinate per frame. */
+        const double source_end = atempo->origin[0] +
+            ((double)atempo->nsamples_out + n_out - atempo->origin[1]) * atempo->tempo;
+        ret = av_dict_set_int(&atempo->dst_buffer->metadata,
+                              "lavfi.atempo.source_end_us",
+                              llrint(source_end * AV_TIME_BASE / outlink->sample_rate), 0);
+        if (ret < 0)
+            return ret;
+    }
+
     ret = ff_filter_frame(outlink, atempo->dst_buffer);
     atempo->dst_buffer = NULL;
     atempo->dst        = NULL;
